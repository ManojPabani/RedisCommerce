{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RedisCommerceDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379",
    "ProductTTLMinutes": 30,
    "CartTTLHours": 24,
    "SessionTTLMinutes": 30,
    "AnalyticsTTLDays": 90
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
